{
  "name": "bff",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/_worker.js --minify",
    "typecheck": "tsgo --noEmit",
    "format-and-lint": "biome check",
    "format-and-lint:fix": "biome check --fix",
    "db:migrate:local": "wrangler d1 migrations apply bff-db --local",
    "db:migrate": "wrangler d1 migrations apply bff-db --remote",
    "db:seed:local": "tsx ../../packages/db/bin/local-seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.23.0",
  "dependencies": {
    "@acme/db": "workspace:*",
    "hono": "^4.11.3",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@acme/biome": "workspace:*",
    "@biomejs/biome": "2.3.10",
    "@cloudflare/workers-types": "4.20251231.0",
    "@typescript/native-preview": "catalog:",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "wrangler": "^4.4.0"
  }
}
