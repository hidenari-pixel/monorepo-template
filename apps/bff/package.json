{
  "name": "bff",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/_worker.js --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:migrate:local": "wrangler d1 migrations apply bff-db --local",
    "db:migrate": "wrangler d1 migrations apply bff-db --remote",
    "db:seed:local": "tsx ../../packages/db/bin/local-seed.ts"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "effect": "catalog:",
    "hono": "^4.11.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "esbuild": "^0.25.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.20.0"
}
