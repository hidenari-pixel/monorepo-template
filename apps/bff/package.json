{
  "name": "bff",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/_worker.js --minify",
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "db:migrate:local": "wrangler d1 migrations apply bff-db --local",
    "db:migrate": "wrangler d1 migrations apply bff-db --remote",
    "db:seed:local": "tsx ../../packages/db/bin/local-seed.ts"
  },
  "dependencies": {
    "@acme/db": "workspace:*",
    "effect": "^3.22.1",
    "hono": "^4.11.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251231.0",
    "@typescript/native-preview": "catalog:",
    "esbuild": "^0.25.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.21.0",
    "wrangler": "^4.4.0"
  },
  "packageManager": "pnpm@11.20.0"
}
